{
  "name": "elecciones-abiertas-colombia",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": "22.x",
    "pnpm": "11.x"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint && uv run ruff check apps/api pipeline",
    "typecheck": "turbo run typecheck && uv run mypy apps/api/src pipeline/src",
    "test": "turbo run test && uv run pytest",
    "test:e2e": "pnpm --filter @elecciones/web test:e2e",
    "contracts:generate": "pnpm --filter @elecciones/contracts generate",
    "check:manifests": "node scripts/validate-manifests.mjs",
    "check:wording": "node scripts/check-public-wording.mjs",
    "check:repository-hygiene": "node scripts/check-repository-hygiene.mjs",
    "release:activate": "node scripts/activate-release.mjs",
    "verify": "pnpm check:manifests && pnpm check:wording && pnpm check:repository-hygiene && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript-eslint": "^8.39.0"
  }
}
