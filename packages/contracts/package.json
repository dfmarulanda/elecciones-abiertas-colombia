{
  "name": "@elecciones/contracts",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./enums": {
      "types": "./dist/enums.d.ts",
      "import": "./dist/enums.js"
    },
    "./openapi": "./openapi.json",
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "openapi.json",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "openapi-typescript openapi.json -o src/generated/api.ts",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "eslint": "^9.32.0",
    "openapi-typescript": "^7.8.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
