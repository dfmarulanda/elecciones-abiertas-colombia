{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eleccionesabiertas.co/schemas/historical-mmv-row.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "round",
    "election_slug",
    "election_date",
    "dep_code",
    "dep_name",
    "mun_code",
    "mun_name",
    "zona_code",
    "puesto_code",
    "puesto_name",
    "mesa_code",
    "corporation_code",
    "corporation_name",
    "circumscription_code",
    "party_code",
    "party_name",
    "category_code",
    "category_name",
    "votes",
    "source_url",
    "content_hash",
    "retrieved_at",
    "data_version",
    "source_type",
    "legal_status",
    "parser_version",
    "transform_version"
  ],
  "properties": {
    "round": { "type": "integer", "enum": [1, 2] },
    "election_slug": { "type": "string" },
    "election_date": { "type": "string", "format": "date" },
    "dep_code": { "type": "string" },
    "dep_name": { "type": "string" },
    "mun_code": { "type": "string" },
    "mun_name": { "type": "string" },
    "zona_code": { "type": "string" },
    "puesto_code": { "type": "string" },
    "puesto_name": { "type": "string" },
    "mesa_code": { "type": "string" },
    "corporation_code": { "type": "string" },
    "corporation_name": { "type": "string" },
    "circumscription_code": { "type": "string" },
    "party_code": { "type": "string" },
    "party_name": { "type": "string" },
    "category_code": { "type": "string" },
    "category_name": { "type": "string" },
    "votes": { "type": "integer", "minimum": 0 },
    "source_url": { "type": "string", "format": "uri" },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "data_version": { "type": "string" },
    "source_type": { "const": "contextual_baseline" },
    "legal_status": { "const": "context_only" },
    "parser_version": { "type": "string" },
    "transform_version": { "type": "string" }
  }
}
