{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eleccionesabiertas.co/schemas/release-manifest.schema.json",
  "title": "Elecciones Abiertas release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "election_slug",
    "data_version",
    "status",
    "synthetic",
    "created_at",
    "methodology_version",
    "parser_versions",
    "git_commit",
    "sources",
    "datasets",
    "aggregate_reconciled",
    "statistical_validation_passed",
    "wording_validation_passed",
    "notes"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "release_id": { "type": "string", "minLength": 1 },
    "election_slug": { "type": "string", "minLength": 1 },
    "data_version": { "type": "string", "minLength": 1 },
    "status": { "enum": ["fixture", "candidate", "published", "withdrawn"] },
    "release_class": { "enum": ["standard", "context_only"] },
    "synthetic": { "type": "boolean" },
    "created_at": { "type": "string", "format": "date-time" },
    "methodology_version": { "type": "string", "minLength": 1 },
    "parser_versions": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "git_commit": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "dataset.schema.json" }
    },
    "aggregate_reconciled": { "type": "boolean" },
    "statistical_validation_passed": { "type": "boolean" },
    "wording_validation_passed": { "type": "boolean" },
    "notes": { "$ref": "#/$defs/localizedText" }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["es", "en"],
      "properties": {
        "es": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected",
        "retrieved",
        "parsed",
        "missing",
        "ambiguous",
        "excluded"
      ],
      "properties": {
        "expected": { "type": "integer", "minimum": 0 },
        "retrieved": { "type": "integer", "minimum": 0 },
        "parsed": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 },
        "ambiguous": { "type": "integer", "minimum": 0 },
        "excluded": { "type": "integer", "minimum": 0 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_type",
        "legal_status",
        "source_url",
        "retrieved_at",
        "content_hash",
        "media_type",
        "byte_size",
        "parser_version",
        "transform_version",
        "coverage"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source_type": {
          "enum": [
            "final_declaration",
            "scrutiny",
            "e14_delegate",
            "e14_transmission",
            "pre_count",
            "contextual_baseline"
          ]
        },
        "legal_status": {
          "enum": [
            "controlling_final",
            "official_scrutiny",
            "documentary_evidence",
            "preliminary",
            "context_only"
          ]
        },
        "source_url": { "type": "string", "format": "uri" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "media_type": { "type": "string", "minLength": 1 },
        "byte_size": { "type": "integer", "minimum": 0 },
        "parser_version": { "type": "string", "minLength": 1 },
        "transform_version": { "type": "string", "minLength": 1 },
        "published_grain": {
          "enum": ["mesa", "place", "municipality", "department", "national"]
        },
        "coverage": { "$ref": "#/$defs/coverage" }
      }
    }
  }
}
