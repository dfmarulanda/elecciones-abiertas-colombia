# These unprefixed names match the repository-root .env.example. The
# ELECCIONES_* variants are accepted as explicit aliases.
DATABASE_URL=
SENTRY_DSN=
ALLOWED_ORIGINS=http://localhost:3000
FIXTURE_DATA_PATH=data/fixtures/fixture-release.json

# Required whenever DATABASE_URL is set. Use a high-entropy deployment secret.
CURSOR_SECRET=

# Exact immutable release to select. If omitted, ACTIVE_RELEASE_POINTER is read.
ACTIVE_RELEASE=
ACTIVE_RELEASE_POINTER=data/manifests/current-release.json

# Comma-separated HTTPS artifact hosts permitted for production dataset redirects.
ARTIFACT_HOSTS=eleccionesabiertas.co
